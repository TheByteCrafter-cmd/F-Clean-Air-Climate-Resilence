# VayuDrishti Environment Configuration Placeholder
# Copy this file to .env for local development
# DO NOT commit .env containing sensitive secrets to source control

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Google Technology Ecosystem (Placeholders - to be configured in later phases)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GCP_PROJECT_ID=your_gcp_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Environmental & Satellite Data Services (Placeholders)
NASA_FIRMS_MAP_KEY=your_firms_map_key_here
