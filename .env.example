# ==============================================================================
# VayuDrishti Environment Configuration Contract
# Copy this template to .env for local development
# NEVER commit a real .env file with production credentials or sensitive keys
# ==============================================================================

# ------------------------------------------------------------------------------
# CATEGORY 1: LOCAL DEVELOPMENT CONFIGURATION (Default values for local run)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8000

# Local Storage & Operational Persistence (Phase 1-2)
LOCAL_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/vayudrishti.db

# ------------------------------------------------------------------------------
# CATEGORY 2: FUTURE EXTERNAL SERVICES & CLOUD INTEGRATIONS (Placeholders Only)
# Note: Do not configure or populate these keys until their respective phases.
# ------------------------------------------------------------------------------

# Google AI Ecosystem (Phase 4: Citizen Multimodal Triage)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform (Phase 3: Interactive Geospatial Intelligence Map)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Cloud Platform & Earth Engine (Phase 2-3: Satellite & Cloud Run)
GCP_PROJECT_ID=your_gcp_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GEE_SERVICE_ACCOUNT=your_gee_service_account_here

# Firebase Real-Time Synchronization (Phase 7-8: Hot Incident Sync)
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here

# External Environmental & Remote Sensing Data APIs (Phase 2: Ingestion Pipeline)
OPENAQ_API_KEY=your_openaq_api_key_here
NASA_FIRMS_MAP_KEY=your_firms_map_key_here
